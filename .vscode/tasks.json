{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Arrival Time Estimator",
            "type": "shell",
            "command": "python src/arrival_estimator.py",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run 8 Unit Tests",
            "type": "shell",
            "command": "python -m unittest discover -s tests -v",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}